// SogitechCodecProcessor.cmajor
// Full codec processor – audio in + params → resynthesis + residual
// ============================================================

processor SogitechCodecProcessor  [[ main ]]
{
    input stream float32 in;
    output stream float32 out;

    input value float osc1Wave      [[ name: "Osc1 Wave", min: 0, max: 3, init: 1, text: "sine|saw|square|tri" ]];
    input value float osc2Wave      [[ name: "Osc2 Wave", min: 0, max: 3, init: 2, text: "sine|saw|square|tri" ]];
    input value float osc1Level     [[ name: "Osc1 Level", min: 0, max: 1, init: 0.80 ]];
    input value float osc2Level     [[ name: "Osc2 Level", min: 0, max: 1, init: 0.80 ]];
    input value float subLevel      [[ name: "Sub Level", min: 0, max: 1, init: 0.50 ]];
    input value float noiseLevel    [[ name: "Noise Level", min: 0, max: 1, init: 0.12 ]];
    input value float additiveBlend [[ name: "Additive Blend", min: 0, max: 1, init: 0.28 ]];
    input value float powerSagDepth [[ name: "PowerSag Depth", min: 0, max: 1, init: 0.26 ]];
    input value float filterLP      [[ name: "Filter LP", min: 0, max: 1, init: 0.72 ]];
    input value float filterHP      [[ name: "Filter HP", min: 0, max: 1, init: 0.08 ]];
    input value float filterRes     [[ name: "Filter Res", min: 0, max: 1, init: 0.22 ]];
    input value float keyTrack      [[ name: "Key Track", min: 0, max: 1, init: 0.55 ]];
    input value float velMod        [[ name: "Vel Mod", min: 0, max: 1, init: 0.62 ]];
    input value float glideTime     [[ name: "Glide Time", min: 0, max: 0.5, init: 0.06 ]];
    input value float midiNote      [[ name: "MIDI Note", min: 0, max: 127, init: 69 ]];
    input value float velocity      [[ name: "Velocity", min: 0, max: 1, init: 0.82 ]];
    input value float residualGain  [[ name: "Residual Gain", min: 0, max: 1, init: 0.15 ]];
    input value float dryWet        [[ name: "Dry/Wet", min: 0, max: 1, init: 1.0 ]];

    float osc1Phase = 0.0, osc2Phase = 0.0, subPhase = 0.0;
    float sagMemory = 1.0, loadMemory = 0.0;
    float lp1 = 0.0, bp1 = 0.0, hp1 = 0.0;
    float lp2 = 0.0, bp2 = 0.0, hp2 = 0.0;
    float currentFreq = 440.0;

    float prewarp (float freq, float sr)
    {
        let omega = 2.0 * pi * freq / sr;
        return 2.0 * sr * tan (omega * 0.5);
    }

    float digitalOsc (float phase)
    {
        float sig = 0.0;
        for (int k = 1; k <= 32; ++k)
            sig += sin (phase * float (k)) / float (k);
        return sig * 0.14;
    }

    float vaOsc (float phase, int waveType)
    {
        switch (waveType)
        {
            case 0: return sin (phase);
            case 1: return (phase / pi) - 1.0;
            case 2: return (phase < pi * 0.5) ? 1.0 : -1.0;
            case 3: return abs (sin (phase));
            default: return sin (phase);
        }
    }

    void main()
    {
        let sampleRate = 96000.0;
        let srInv = 1.0 / sampleRate;

        loop
        {
            let targetFreq = 440.0 * pow (2.0, (midiNote - 69.0) / 12.0);
            let glideCoeff = exp (-1.0 / (max (glideTime, 0.001) * sampleRate));
            currentFreq = currentFreq * glideCoeff + targetFreq * (1.0 - glideCoeff);

            let baseLP = filterLP * 18000.0;
            let baseHP = filterHP * 120.0;
            let keyMod   = ((midiNote - 60.0) / 48.0) * keyTrack * 0.6;
            let pressMod = velocity * velMod * 2400.0;

            let lpCutoff = clamp (baseLP * (1.0 + keyMod) + pressMod * 0.7, 180.0, 22000.0);
            let hpCutoff = clamp (baseHP * (1.0 + keyMod * 0.5) - pressMod * 0.3, 18.0, 7500.0);
            let res      = clamp (filterRes * (1.0 + velocity * 0.35), 0.0, 0.95);

            let phaseInc = currentFreq * 2.0 * pi * srInv;
            osc1Phase = fmod (osc1Phase + phaseInc, 2.0 * pi);
            osc2Phase = fmod (osc2Phase + phaseInc * 1.01, 2.0 * pi);
            subPhase  = fmod (subPhase  + phaseInc * 0.5, 2.0 * pi);

            float vaSig = vaOsc (osc1Phase, int (osc1Wave)) * osc1Level
                        + vaOsc (osc2Phase, int (osc2Wave)) * osc2Level
                        + sin (subPhase) * subLevel
                        + (random() * 2.0 - 1.0) * noiseLevel;

            float additiveSig = digitalOsc (osc1Phase);
            float mixed = (1.0 - additiveBlend) * vaSig + additiveBlend * additiveSig;

            let rectifier = abs (mixed);
            loadMemory = 0.992 * loadMemory + 0.008 * rectifier;
            sagMemory *= exp (-0.12 * powerSagDepth * loadMemory * srInv);
            sagMemory  = max (0.48, sagMemory);
            mixed *= sagMemory;

            let lpK  = prewarp (lpCutoff, sampleRate) * srInv;
            let hpK  = prewarp (hpCutoff, sampleRate) * srInv;
            let damp = 1.0 / (1.0 + 2.0 * res);

            hp1 = (mixed - lp1 - bp1 * damp) / (1.0 + lpK * lpK);
            bp1 += lpK * hp1;
            lp1 += lpK * bp1;

            hp2 = (hp1 - lp2 - bp2 * damp) / (1.0 + hpK * hpK);
            bp2 += hpK * hp2;
            lp2 += hpK * bp2;

            let filtered = lp2 * 0.72 + hp2 * 0.28;
            float synth = filtered * 0.78;
            float residual = in * residualGain;
            out <- (1.0 - dryWet) * residual + dryWet * (synth + residual * 0.3);
            advance();
        }
    }
}
